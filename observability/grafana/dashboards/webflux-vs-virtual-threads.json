{
  "uid": "webflux-vs-vt",
  "title": "Coffee Code #2 · WebFlux vs Virtual Threads",
  "description": "Comparación en tiempo real de banking-api-webflux (azul) y banking-api-virtual-threads (naranja).",
  "tags": [
    "coffee-code",
    "webflux",
    "virtual-threads"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Petición de negocio: GET /api/clients/{clientId}/financial-summary (lado servidor)",

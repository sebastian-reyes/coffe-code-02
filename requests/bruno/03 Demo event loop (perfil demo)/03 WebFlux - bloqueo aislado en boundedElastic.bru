meta {
  name: WebFlux - bloqueo aislado en boundedElastic
  type: http
  seq: 3
}

get {
  url: {{webfluxUrl}}/api/demo/legacy-score/C0001?mode=offload
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.thread: contains boundedElastic
}

docs {
  Requiere las APIs con el perfil demo (PROFILE=demo ./scripts/start-all.sh). Usan URLs fijas, no {{api}}. La corrección.
}

  res.body.virtual: eq true
}

docs {
  Requiere las APIs con el perfil demo (PROFILE=demo ./scripts/start-all.sh). Usan URLs fijas, no {{api}}. Desde Java 24 (JEP 491) synchronized ya no ancla el hilo virtual a su carrier.
}
